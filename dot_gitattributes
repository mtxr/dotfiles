* text=auto eol=lf
* whitespace=blank-at-eol,space-before-tab,-blank-at-eof
* merge=mergiraf

package-lock.json -diff
yarn.lock         -diff
pnpm-lock.yaml    -diff
poetry.lock       -diff

*.png   diff=exif
*.jpg   diff=exif
*.jpeg  diff=exif
*.gif   diff=exif
*.ico   diff=exif
*.pdf   diff=exif
*.woff  diff=exif
*.woff2 binary

*.sh  text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

*.zip diff=zip
*.json diff=json_pretty
