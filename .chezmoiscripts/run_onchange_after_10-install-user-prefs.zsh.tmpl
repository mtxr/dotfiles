#!/usr/bin/env bash
set -e

# Re-runs when this rendered script or the mise config template changes.
# Installs mise tools declared in ~/.config/mise/config.toml (already applied),
# then prunes whatever no config asks for anymore, so removing a tool from the
# config uninstalls it.
# mise config {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# Prompt answers (the template above already depends on them, kept for clarity):
# node={{ .install.node }} rust={{ .install.rust }} zig={{ .install.zig }}
# golang={{ .install.golang }} ruby={{ .install.ruby }} reactnative={{ .install.reactnative }}

# mise comes from the dotfiles Nix profile, built by run_onchange_after_05-nix-profile.
export PATH="${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles/dotfiles/bin:$PATH"

if ! command -v mise &>/dev/null; then
  echo "❌ mise not found in the dotfiles Nix profile. Did the Nix profile build run?"
  exit 1
fi

echo "🔄 Installing mise tools from ~/.config/mise/config.toml ..."
mise install -y
echo "✅ mise tools installed."
echo "🔄 Pruning mise tools no config asks for..."
mise prune -y

{{- if .install.reactnative }}
## TODO REVIEW THIS
echo "🔄 Installing React Native Ruby gems (ffi, cocoapods)..."
mise exec ruby -- sudo gem install ffi
mise exec ruby -- sudo gem install cocoapods
# brew tap facebook/fb
# brew install idb-companion
# pip3 install fb-idb --break-system-packages
# brew install ios-deploy
{{- end }}
